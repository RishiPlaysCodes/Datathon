# PRAHARI Backend Environment Variables
# Copy this to .env and fill in real values for production

# Database (defaults to SQLite for local dev if not set)
# DATABASE_URL=postgresql+asyncpg://prahari:prahari123@db:5432/prahari
# DATABASE_URL_SYNC=postgresql://prahari:prahari123@db:5432/prahari

# JWT - CHANGE THIS SECRET IN PRODUCTION (use a long random string)
SECRET_KEY=change-this-to-a-long-random-secret-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional)
# REDIS_URL=redis://localhost:6379/0

# Gemini AI - ENABLES REAL CONVERSATIONAL AI (answers anything, any language)
# Get a FREE key from https://aistudio.google.com/app/apikey
# Without this, the chat uses the rule-based fallback engine.
GEMINI_API_KEY=
